type BinOp
  = AddOp
  | SubOp
  | MultOp
  | DivOp
  | ModOp
  | AndOp
  | OrOp
  | EqOp
  | NotEqOp
  | LessThanOp
  | LessThanEqOp
  | GreaterThanOp
  | GreaterThanEqOp;

type UnaryOp
  = NotOp
  | NegateOp;

type Type
  = NumberType
  | BoolType
  | StringType
  | NullType
  | FuncType [Type] Type
  | RecordType [TypeField];
  
type TypeField 
  = TypeField String Type;

type Parameter 
  = Parameter String Type;

type RecordField 
  = RecordField String Expr;

type Program
  = Program [Stmt]

type Expr 
  = NumberExpr Float 
  | BoolExpr Bool
  | StringExpr String
  | NullExpr 
  | VarExpr String
  | AssignExpr String Expr
  | BinExpr BinOp Expr Expr // Operation Left Right
  | UnaryExpr UnaryOp Expr
  | FnExpr [Parameter] Type Expr // inputParams(may be mutliple) retType func 
  | AppExpr Expr [Expr] // may be multiple arguments
  | RecordExpr [RecordField]
  | FieldExpr Expr String;

type Stmt
  = LetStmt String (Option Type) Expr // Name Type Binding Binded
  | IfStmt Expr Stmt (Option Stmt) // Cond TruePath FalsePath
  | WhileStmt Expr Stmt // Cond Loop 
  | BlockStmt [Stmt] // Many Expressions about
  | ExprStmt Expr;